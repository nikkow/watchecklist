# TMDB API read access token (v4 auth), from https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=

# Matomo audience statistics, cookieless. Leave unset locally so development visits are not counted.
# In production they come from the MATOMO_URL and MATOMO_SITE_ID repository variables.
PUBLIC_MATOMO_URL=
PUBLIC_MATOMO_SITE_ID=

---
import '@fontsource/big-shoulders-display/latin-800';
import '@fontsource/big-shoulders-display/latin-900';
import '@fontsource/schibsted-grotesk/latin-400.css';
import '@fontsource/schibsted-grotesk/latin-600.css';
import '@fontsource/schibsted-grotesk/latin-700.css';
import '../styles/global.css';
import wordmarkFont from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-900-normal.woff2?url';
import navFont from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-600-normal.woff2?url';
import bodyFont from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-400-normal.woff2?url';
import boldFont from '@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-700-normal.woff2?url';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { locales, useTranslations, type Locale } from '../i18n';
import type { Alternates, PageKey } from '../i18n/routes';
import { alternateLinks, openGraphLocale } from '../seo/alternates';
import { backgroundColor } from '../site';

interface Props {
  locale: Locale;
  /** The page's path in every locale. */
  alternates: Alternates;
  /** Navigation entry to mark as current, if the page belongs to one. */
  current?: PageKey;
  /** Page title, followed by the site name; the home page leaves it out. */
  title?: string;
  description?: string;
  /** Picture shown when the page is shared; the app icon otherwise. */
  image?: ImageMetadata | null;
}

const { locale, alternates, current, title, description, image } = Astro.props;
const t = useTranslations(locale);
const metaDescription = description ?? t.meta.description;
const site = Astro.site;
if (!site) throw new Error('Set `site` in astro.config to build canonical URLs');
const fullTitle = title ? `${title} · watchecklist` : t.meta.title;
const canonical = new URL(alternates[locale], site);
// Social networks expect a JPEG about 1200 px wide; the app icon stands in on pages without one.
const shareImage = image
  ? new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, site)
  : new URL('/icons/icon-512.png', site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={backgroundColor} />
    {
      /* Fonts of the first screen are preloaded so text never renders in a fallback face first:
         a late swap would resize paragraphs and push the footer down. */
      [wordmarkFont, navFont, bodyFont, boldFont].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {alternateLinks(alternates, site).map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="watchecklist" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:locale" content={openGraphLocale(locale)} />
    {locales
      .filter((option) => option !== locale)
      .map((option) => (
        <meta property="og:locale:alternate" content={openGraphLocale(option)} />
      ))}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="watchecklist" />
  </head>
  <body>
    <Header locale={locale} alternates={alternates} current={current} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} alternates={alternates} />
    <script>
      import { trackPageView } from '../analytics/matomo';
      import { registerServiceWorker } from '../pwa/register';
      // A worker in development would serve stale pages over the dev server.
      if (import.meta.env.PROD) registerServiceWorker();
      trackPageView();
    </script>
  </body>
</html>

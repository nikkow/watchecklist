---
/**
 * Brand mark and wordmark on the dark site: Papier frame and short arm, Vermillon long arm,
 * knockout in the page background. Geometry copied from `brand/variant-b/mark.svg`.
 */
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
const clipId = 'wcl-logo-long-arm';
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 120 120" aria-hidden="true">
    <defs>
      <clipPath id={clipId}>
        <polygon points="45.6,-10 130,-10 130,130 55.5,130"></polygon>
      </clipPath>
    </defs>
    <rect class="frame" x="14" y="26" width="78" height="78" fill="none" stroke-width="7"></rect>
    <path class="knockout" d="M52 80 L100 16" fill="none" stroke-width="25"></path>
    <path
      class="short-arm"
      d="M32 60 L52 80 L100 16"
      fill="none"
      stroke-width="13"
      stroke-linejoin="miter"
      stroke-miterlimit="10"
    ></path>
    <path
      class="long-arm"
      d="M32 60 L52 80 L100 16"
      fill="none"
      stroke-width="13"
      stroke-linejoin="miter"
      stroke-miterlimit="10"
      clip-path={`url(#${clipId})`}
    ></path>
  </svg>
  <span class="wordmark">
    WAT<span class="shared">CH</span>ECKLIST
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .frame,
  .short-arm {
    stroke: var(--wcl-text);
  }
  .knockout {
    stroke: var(--wcl-bg);
  }
  .long-arm {
    stroke: var(--wcl-vermilion);
  }
  .wordmark {
    font-family: var(--wcl-font-display);
    font-weight: 900;
    font-size: 20px;
    letter-spacing: 0.03em;
    color: var(--wcl-text);
  }
  .shared {
    color: var(--wcl-vermilion);
  }
  @media (min-width: 1024px) {
    .wordmark {
      font-size: 25px;
    }
  }
</style>

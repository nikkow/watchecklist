---
import LanguageMenu from './LanguageMenu.astro';
import Logo from './Logo.astro';
import { useTranslations, type Locale } from '../i18n';
import { pagePath, type PageKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);
const links: { key: PageKey; label: string }[] = [
  { key: 'home', label: t.header.lists },
  { key: 'about', label: t.header.about },
];
---

<header class="wcl-container">
  <a class="home" href={pagePath('home', locale)} aria-label={t.header.home}>
    <Logo />
  </a>
  <nav aria-label={t.header.primaryNav}>
    {links.map((link) => (
      <a href={pagePath(link.key, locale)} aria-current={link.key === page ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
  <LanguageMenu locale={locale} page={page} />
</header>

<style>
  header {
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .home {
    display: flex;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }
  nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    gap: 4px;
    font-size: 15px;
    font-weight: 600;
  }
  nav a {
    min-height: 44px;
    padding: 0 8px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    opacity: 1;
  }
  /* On phones the header keeps the logo and language only; About stays reachable from the footer. */
  @media (max-width: 479px) {
    nav a {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    header {
      min-height: 88px;
      gap: 56px;
    }
    nav {
      justify-content: flex-start;
      gap: 28px;
    }
    nav a {
      padding: 0;
    }
  }
</style>

---
import type { Locale } from '../i18n';

/** Small flag drawn for a locale in the language menu. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const clipId = `wcl-flag-${locale}`;
---

<svg class="flag" width="21" height="14" viewBox="0 0 60 40" aria-hidden="true">
  {locale === 'fr' ? (
    <>
      <rect width="20" height="40" fill="#002654" />
      <rect x="20" width="20" height="40" fill="#FFFFFF" />
      <rect x="40" width="20" height="40" fill="#CE1126" />
    </>
  ) : (
    <>
      <defs>
        <clipPath id={clipId}>
          <rect width="60" height="40" />
        </clipPath>
      </defs>
      <g clip-path={`url(#${clipId})`}>
        <rect width="60" height="40" fill="#012169" />
        <path d="M0 0L60 40M60 0L0 40" stroke="#FFFFFF" stroke-width="8" />
        <path d="M0 0L60 40M60 0L0 40" stroke="#C8102E" stroke-width="3" />
        <path d="M30 0V40M0 20H60" stroke="#FFFFFF" stroke-width="12" />
        <path d="M30 0V40M0 20H60" stroke="#C8102E" stroke-width="7" />
      </g>
    </>
  )}
</svg>

<style>
  .flag {
    flex: none;
    border-radius: 3px;
  }
</style>

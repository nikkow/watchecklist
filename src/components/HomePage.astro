---
import BaseLayout from '../layouts/BaseLayout.astro';
import ListCard from './list/ListCard.astro';
import { listViews } from './list/listPaths';
import { useTranslations, type Locale } from '../i18n';
import { pages } from '../i18n/routes';
import { suggestListUrl } from '../site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const lists = await listViews(locale);
---

<BaseLayout locale={locale} alternates={pages.home} current="home">
  <section class="hero wcl-container">
    <h1 class="wcl-page-title">{t.home.title}</h1>
    <p class="subtitle">{t.home.subtitle}</p>
    <p class="intro">{t.home.intro}</p>
  </section>

  <section class="lists wcl-container" aria-labelledby="lists-title">
    <h2 id="lists-title" class="wcl-display">
      {t.home.listsTitle}
    </h2>
    {lists.length > 0 ? (
      <ul class="cards">
        {lists.map((view, index) => (
          <ListCard locale={locale} view={view} priority={index === 0} />
        ))}
      </ul>
    ) : (
      <p class="empty-text">{t.home.listsEmpty}</p>
    )}
    <a class="suggest" href={suggestListUrl}>
      {t.home.suggestList}
    </a>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 32px;
    display: grid;
    gap: 14px;
  }
  .subtitle {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
  }
  .intro {
    margin: 0;
    max-width: 36em;
    color: var(--wcl-text-soft);
  }
  .lists {
    margin-top: var(--wcl-section-gap);
  }
  h2 {
    margin: 0 0 16px;
    font-size: 30px;
    line-height: 1;
  }
  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 32px;
  }
  .empty-text {
    margin: 0;
    color: var(--wcl-text-soft);
  }
  .suggest {
    margin-top: 24px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 700;
  }
  @media (min-width: 1024px) {
    .hero {
      padding-top: 40px;
      gap: 20px;
    }
    .subtitle {
      font-size: 24px;
    }
    .intro {
      font-size: 19px;
    }
    h2 {
      margin-bottom: 28px;
      font-size: 56px;
    }
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../i18n';
import { pages } from '../i18n/routes';
import { repositoryUrl, tmdbUrl } from '../site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} alternates={pages.about} current="about" title={t.about.title}>
  <article class="wcl-container">
    <h1 class="wcl-page-title">{t.about.title}</h1>
    <p class="intro">{t.about.intro}</p>

    <h2>{t.about.privacyTitle}</h2>
    <p>{t.about.privacy}</p>
    <p>{t.about.stats}</p>
    <label class="stats-choice">
      <input type="checkbox" data-stats-choice checked />
      {t.about.statsChoice}
    </label>

    <h2>{t.about.dataTitle}</h2>
    <p>{t.about.data}</p>
    <p>
      {t.footer.tmdbNotice} <a href={tmdbUrl}>{t.about.tmdbLink}</a>
    </p>

    <h2>{t.about.codeTitle}</h2>
    <p>
      {t.about.code} <a href={repositoryUrl}>{t.footer.sourceCode}</a>
    </p>
  </article>
</BaseLayout>

<script>
  import { isOptedOut, setOptedOut } from '../analytics/matomo';

  const choice = document.querySelector<HTMLInputElement>('[data-stats-choice]');
  if (choice) {
    choice.checked = !isOptedOut();
    choice.addEventListener('change', () => setOptedOut(!choice.checked));
  }
</script>

<style>
  article {
    padding-top: 32px;
  }
  /* The article stays aligned with the header; only the reading measure is capped. */
  article > * {
    max-width: 44em;
  }
  h1 {
    margin-bottom: 20px;
  }
  h2 {
    margin: 36px 0 8px;
    font-size: 19px;
    font-weight: 700;
  }
  p {
    margin: 0 0 12px;
    color: var(--wcl-text-soft);
  }
  .stats-choice {
    display: flex;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    color: var(--wcl-text);
    cursor: pointer;
  }
  .stats-choice input {
    width: 20px;
    height: 20px;
    margin: 0;
    flex-shrink: 0;
    accent-color: var(--wcl-text);
  }
  .intro {
    color: var(--wcl-text);
    font-size: 19px;
  }
</style>

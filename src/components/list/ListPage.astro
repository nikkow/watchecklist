---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListItem from './ListItem.astro';
import { useTranslations, type Locale } from '../../i18n';
import { listAlternates, pagePath } from '../../i18n/routes';
import type { ListView } from '../../lists/view-types';
import { tmdbImage } from '../../tmdb/images';

/**
 * A watch list: cover and progress, next-up card, filters, then the sections. Everything is
 * rendered at build time; the script below adds ticking, filtering and the next-up card.
 */
interface Props {
  locale: Locale;
  view: ListView;
}

const { locale, view } = Astro.props;
const t = useTranslations(locale);
const cover = tmdbImage(view.cover.image);
const firstItem = view.sections.flatMap((section) =>
  section.blocks.flatMap((block) => (block.type === 'item' ? [block.item] : block.items)),
)[0];
const firstPoster = tmdbImage(firstItem?.poster ?? null);
const importanceFilters = [
  { value: 'all', label: t.list.showAll },
  { value: 'no-optional', label: t.list.withoutOptional },
  { value: 'essential', label: t.list.essentialOnly },
] as const;
const githubUrl = (handle: string) => `https://github.com/${handle}`;
---

<BaseLayout
  locale={locale}
  alternates={listAlternates(view.slug)}
  current="home"
  title={view.title}
  description={view.description}
>
  <div class="list" data-list={view.slug}>
    <section class="hero wcl-container">
      <a class="back" href={pagePath('home', locale)}>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
        {t.list.backToLists}
      </a>
      <div class="cover">
        {cover && (
          <Image
            src={cover}
            alt=""
            widths={[400, 800, 1280]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
            style={`object-position: ${view.cover.focus}`}
          />
        )}
        <svg class="breakout" width="96" height="96" viewBox="0 0 96 96" aria-hidden="true">
          <path class="knockout" d="M22 58 L40 74 L84 12"></path>
          <path class="stroke" d="M22 58 L40 74 L84 12"></path>
        </svg>
      </div>
      <div class="intro">
        <h1 class="wcl-page-title">{view.title}</h1>
        <p class="stats">{view.stats.join(' · ')}</p>
        <p class="description">{view.description}</p>
        <div class="progress">
          <div
            class="track"
            role="progressbar"
            aria-label={t.list.progress}
            aria-valuemin="0"
            aria-valuemax={view.itemCount}
            aria-valuenow="0"
            data-progress
          >
            <div class="fill"></div>
          </div>
          <span class="count" data-progress-label>
            0 / {view.itemCount}
          </span>
        </div>
        <section class="next" aria-labelledby="next-title" data-next-card>
          <div class="next-body">
            {firstPoster ? (
              <Image
                class="next-poster"
                src={firstPoster}
                alt=""
                widths={[80, 120]}
                sizes="56px"
                data-next-poster
              />
            ) : (
              <span class="next-poster" aria-hidden="true" />
            )}
            <div class="next-text">
              <h2 id="next-title">{t.list.nextUp}</h2>
              <span class="next-name" data-next-name>
                {firstItem?.fullName}
              </span>
              <span class="next-episode-title" data-next-title hidden>
                {firstItem?.title}
              </span>
              <span class="next-hint" data-next-hint hidden={!firstItem?.crossoverHint}>
                {firstItem?.crossoverHint}
              </span>
            </div>
          </div>
          <button class="mark" type="button" data-next-mark>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12.5l4.5 4.5L19 7.5"></path>
            </svg>
            {t.list.markWatched}
          </button>
        </section>
        <p class="done" data-all-watched hidden>
          {t.list.allWatched}
        </p>
        <p class="warning" data-storage-warning hidden>
          {t.list.storageUnavailable}
        </p>
      </div>
    </section>

    <section class="filters wcl-container" aria-label={t.list.filters} data-filters hidden>
      <div class="series" role="group" aria-label={t.list.seriesFilter}>
        {view.series.map((series) => {
          const poster = tmdbImage(series.poster);
          return (
            <button type="button" aria-pressed="true" data-series-filter={series.key}>
              {poster ? (
                <Image src={poster} alt="" widths={[72, 108]} sizes="36px" />
              ) : (
                <span class="avatar" aria-hidden="true" />
              )}
              {series.name}
            </button>
          );
        })}
      </div>
      <div class="toggles">
        <div class="segments" role="group" aria-label={t.list.importanceFilter}>
          {importanceFilters.map((filter) => (
            <button
              type="button"
              aria-pressed={filter.value === 'all' ? 'true' : 'false'}
              data-importance-filter={filter.value}
            >
              {filter.label}
            </button>
          ))}
        </div>
        <div class="switches">
          {[
            { key: 'crossoversOnly', label: t.list.crossoversOnly },
            { key: 'hideWatched', label: t.list.hideWatched },
            { key: 'showTitles', label: t.list.showTitles },
          ].map((option) => (
            <button class="switch" type="button" aria-pressed="false" data-switch={option.key}>
              {option.label}
              <span class="knob" aria-hidden="true">
                <span />
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <div class="sections wcl-container">
      {view.sections.map((section) => (
        <details class="section" data-section>
          <summary>
            <span class="heading">
              <h2 class="wcl-display">{section.title}</h2>
              <span class="seasons">{section.seasons}</span>
            </span>
            <span class="section-count" data-section-count>
              0 / {section.itemCount}
            </span>
            <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          {section.note && <p class="section-note">{section.note}</p>}
          <ol class="items">
            {section.blocks.map((block) =>
              block.type === 'item' ? (
                <ListItem item={block.item} />
              ) : (
                <li class="crossover" data-crossover>
                  <p class="crossover-header">
                    <span class="bar" aria-hidden="true" />
                    {block.header}
                  </p>
                  <ol class="items">
                    {block.items.map((item) => (
                      <ListItem item={item} />
                    ))}
                  </ol>
                </li>
              ),
            )}
          </ol>
        </details>
      ))}
    </div>

    <p class="no-match wcl-container" data-no-match hidden>
      {t.list.noMatch}
    </p>

    <p class="credits wcl-container">
      {t.list.authors}{' '}
      {view.authors.map((handle, index) => (
        <>
          {index > 0 && ', '}
          <a href={githubUrl(handle)} aria-label={t.list.githubProfile(handle)}>
            @{handle}
          </a>
        </>
      ))}
      {view.curators.length > 0 && (
        <>
          {' · '}
          {t.list.curatedBy}{' '}
          {view.curators.map((handle, index) => (
            <>
              {index > 0 && ', '}
              <a href={githubUrl(handle)} aria-label={t.list.githubProfile(handle)}>
                @{handle}
              </a>
            </>
          ))}
        </>
      )}
    </p>
  </div>
</BaseLayout>

<script>
  import { startListPage } from '../../progress/list-page';
  startListPage();
</script>

<style>
  .hero {
    padding-top: 12px;
    display: grid;
    gap: 22px;
  }
  .back {
    justify-self: start;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    color: var(--wcl-muted);
  }
  .back svg,
  .chevron,
  .mark svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
  }
  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--wcl-radius-card);
    background: var(--wcl-surface);
  }
  .breakout {
    position: absolute;
    right: -14px;
    top: -18px;
  }
  .breakout path {
    fill: none;
    stroke-linejoin: miter;
    stroke-miterlimit: 10;
  }
  .breakout .knockout {
    stroke: var(--wcl-bg);
    stroke-width: 26;
  }
  .breakout .stroke {
    stroke: var(--wcl-vermilion);
    stroke-width: 12;
  }
  .intro {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .stats {
    margin: 0;
    font-size: 15px;
    color: var(--wcl-muted);
    font-variant-numeric: tabular-nums;
  }
  .description {
    margin: 0;
    max-width: 36em;
    color: var(--wcl-text-soft);
  }
  .progress {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
  }
  .track {
    flex: 1;
    height: 6px;
    border-radius: var(--wcl-radius-pill);
    background: var(--wcl-surface-2);
    overflow: hidden;
  }
  .fill {
    width: var(--progress, 0%);
    height: 100%;
    background: var(--wcl-text);
  }
  .count {
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .next {
    margin-top: 16px;
    padding: 16px;
    border-radius: var(--wcl-radius-card);
    background: var(--wcl-surface);
    display: grid;
    gap: 16px;
  }
  .next[hidden],
  [hidden] {
    display: none;
  }
  .next-body {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .next-poster {
    flex: none;
    width: 56px;
    height: 84px;
    border-radius: var(--wcl-radius-small);
    object-fit: cover;
    background: var(--wcl-surface-2);
  }
  .next-text {
    min-width: 0;
    display: grid;
    gap: 3px;
  }
  .next h2 {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--wcl-muted);
  }
  .next-name {
    font-size: 19px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .next-episode-title {
    color: var(--wcl-text-soft);
  }
  .next-hint {
    font-size: 14px;
    color: var(--wcl-text-soft);
  }
  .mark {
    min-height: 52px;
    border: 0;
    border-radius: var(--wcl-radius-button);
    background: var(--wcl-vermilion-strong);
    color: var(--wcl-text);
    font: inherit;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
  }
  .done,
  .warning {
    margin: 16px 0 0;
    padding: 16px;
    border-radius: var(--wcl-radius-card);
    background: var(--wcl-surface);
    font-weight: 600;
  }
  .warning {
    font-weight: 400;
    color: var(--wcl-text-soft);
  }

  .filters {
    margin-top: 36px;
    display: grid;
    gap: 18px;
  }
  .series {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--wcl-gutter) * -1);
    padding-inline: var(--wcl-gutter);
  }
  .series button {
    flex: none;
    height: 44px;
    padding: 0 14px 0 4px;
    border: 0;
    border-radius: var(--wcl-radius-pill);
    background: var(--wcl-surface);
    color: var(--wcl-text);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
  .series button[aria-pressed='false'] {
    opacity: 0.35;
    filter: grayscale(1);
  }
  .series img,
  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 12%;
    background: var(--wcl-surface-2);
  }
  .toggles {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .segments {
    --inset: 4px;
    display: flex;
    padding: var(--inset);
    border-radius: var(--wcl-radius-button);
    background: var(--wcl-surface);
  }
  .segments button {
    min-height: 36px;
    padding: 0 12px;
    border: 0;
    /* Concentric with the control: its radius minus the inset. */
    border-radius: calc(var(--wcl-radius-button) - var(--inset));
    background: transparent;
    color: var(--wcl-muted);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .segments button[aria-pressed='true'] {
    background: var(--wcl-surface-selected);
    color: var(--wcl-text);
  }
  .switch {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--wcl-muted);
    font: inherit;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
  .knob {
    width: 44px;
    height: 26px;
    padding: 3px;
    border-radius: var(--wcl-radius-pill);
    background: var(--wcl-surface-selected);
    display: flex;
  }
  .knob span {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--wcl-text);
  }
  .switch[aria-pressed='true'] .knob {
    justify-content: flex-end;
    background: var(--wcl-vermilion-strong);
  }

  .sections {
    margin-top: 40px;
    display: grid;
    gap: 8px;
  }
  .section summary {
    min-height: 68px;
    padding: 12px 16px;
    border-radius: var(--wcl-radius-button);
    background: var(--wcl-surface);
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    list-style: none;
  }
  .section summary::-webkit-details-marker {
    display: none;
  }
  .section[open] summary {
    background: transparent;
    padding-inline: 8px;
  }
  .heading {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 2px;
  }
  .section h2 {
    margin: 0;
    font-size: 24px;
    line-height: 1.05;
  }
  .section[open] h2 {
    font-size: 30px;
  }
  .seasons,
  .section-count {
    font-size: 13px;
    color: var(--wcl-muted);
    font-variant-numeric: tabular-nums;
  }
  .chevron {
    flex: none;
    color: var(--wcl-muted);
    transition: transform 0.2s;
  }
  .section[open] .chevron {
    transform: rotate(180deg);
  }
  .section-note {
    margin: 0 8px 8px;
    font-size: 14px;
    color: var(--wcl-text-soft);
  }
  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .section > .items {
    margin-inline: -8px;
  }
  .crossover {
    margin: 6px 0;
    padding-bottom: 4px;
    border-radius: var(--wcl-radius-card);
    background: var(--wcl-surface);
  }
  .crossover-header {
    margin: 0;
    padding: 12px 12px 2px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
  }
  .bar {
    width: 18px;
    height: 4px;
    border-radius: 2px;
    background: var(--wcl-vermilion);
  }
  .section[hidden] {
    display: none;
  }
  .no-match {
    margin-top: 16px;
    color: var(--wcl-text-soft);
  }
  .switches {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  .credits {
    margin-top: 40px;
    font-size: 14px;
    color: var(--wcl-muted);
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: 24px;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 48px;
      align-items: start;
    }
    .back {
      grid-column: 1 / -1;
    }
    /* The title shares the row with the cover, so it scales with its column: a ten-letter
       word is about five times the font size wide, and 18% of the column keeps it on one line. */
    .intro {
      container-type: inline-size;
    }
    .intro .wcl-page-title {
      font-size: clamp(48px, 18cqi, 128px);
    }
    /* Rows keep a readable width while the page stays aligned with the header. */
    .filters > *,
    .sections > * {
      max-width: 880px;
    }
    .series {
      flex-wrap: wrap;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
</style>
